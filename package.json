{
  "name": "dfts-common",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "nx": "nx",
    "start": "nx serve",
    "build": "nx run-many --parallel 10 --target build --all",
    "test": "nx run-many --parallel 10 --target test --all --",
    "lint": "nx run-many --parallel 10 --target lint --all --fix",
    "lint:check": "nx run-many --parallel 10 --target lint --all",
    "graph": "nx graph",
    "format:check": "PRETTIER_EXPERIMENTAL_CLI=1 prettier --check .",
    "format": "PRETTIER_EXPERIMENTAL_CLI=1 prettier --write ."
  },
  "packageManager": "pnpm@11.28.9",
  "private": true,
  "dependencies": {
    "chokidar": "5.0.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@jscutlery/semver": "6.2.0",
    "@nx/devkit": "24.0.3",
    "@nx/eslint": "24.0.3",
    "@nx/eslint-plugin": "24.0.3",
    "@nx/js": "24.0.3",
    "@nx/rollup": "24.0.3",
    "@nx/vitest": "24.0.3",
    "@nx/workspace": "24.0.3",
    "@types/node": "24.19.2",
    "@typescript-eslint/utils": "8.72.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsonc": "3.4.2",
    "fs-extra": "11.4.1",
    "jsdom": "29.1.1",
    "jsonc-eslint-parser": "3.3.0",
    "nx": "24.0.3",
    "prettier": "3.9.10",
    "prettier-plugin-organize-attributes": "1.0.0",
    "prettier-plugin-sort-json": "4.2.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rollup": "4.67.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
